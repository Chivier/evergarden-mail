# Evergarden application settings.
#
# This file is the template for .local/run/runtime.env, which every Evergarden
# container reads (env_file in docker-compose.yaml). ./deploy/setup copies it
# with generated values; edit .local/run/runtime.env afterwards and restart the
# stack (docker compose up -d) to apply a change.
#
# Compose-level settings (project name, images, host ports, UID/GID, profiles)
# do not belong here; they live in .env (see .env.example).
#
# Secrets never appear in this file. Every secret is a file under .local/run
# that docker-compose.yaml mounts read-only at the path named here.
#
# A line commented out means "not set": the built-in default applies. An empty
# value (KEY=) also means "not set".

# --- Identity and the write switch -------------------------------------------

# Stable name of this deployment (letters, digits, '.', '_' or '-'). It is bound
# into the encryption of stored provider credentials and approvals, so choose it
# once and NEVER change it: a changed id makes existing credentials undecryptable.
EVERGARDEN_HOST_ID=default
# The one host allowed to write; unset means this host. "none" forbids writes.
#EVERGARDEN_ACTIVE_WRITER=
# Must match the database writer-control row; the migrate service records it.
EVERGARDEN_WRITER_EPOCH=1
# THE write switch. false (the default) keeps the install read-only: it syncs and
# archives mail, prepares drafts and records human approvals, but sends, moves
# and marks nothing at the provider. Set true to let approved actions run, then
# `docker compose up -d` (the migrate service updates the database writer
# control). Every write still needs a human approval in the web UI.
EVERGARDEN_SIDE_EFFECTS_ENABLED=false
# Moving mail to Trash is a separate switch and never skips the human gate.
EVERGARDEN_TRASH_ACTIONS_ENABLED=false
# With writes enabled: execute human approvals in the background, independent
# of whether an MCP client is still connected.
EVERGARDEN_APPROVAL_DISPATCH_ENABLED=false
# Mailboxes the dispatcher executes at the same time (1-8).
EVERGARDEN_APPROVAL_DISPATCH_PARALLEL=4
# Intent kinds that skip the human approval surface: any of send,archive,move,mark
# (or "all"). Empty means every write waits for a human. "trash" is never accepted.
EVERGARDEN_AUTO_APPROVE=
# Review window, in hours, of a draft awaiting human approval (1-72).
EVERGARDEN_APPROVAL_DRAFT_LIFETIME_HOURS=6
# Account aliases without IMAP MOVE that may move with UID COPY + UID EXPUNGE.
EVERGARDEN_UIDPLUS_MOVE_ACCOUNTS=
# IANA timezone in which config/jobs.yaml schedules are evaluated.
EVERGARDEN_SCHEDULE_TIMEZONE=UTC

# --- Storage (paths inside the containers) -----------------------------------

EVERGARDEN_DATABASE_URL=postgresql://evergarden@postgres:5432/evergarden
EVERGARDEN_ARCHIVE_DIR=/data/archive
EVERGARDEN_REPORT_DIR=/data/reports
EVERGARDEN_CREDENTIAL_DB=/data/secrets/credentials.db
EVERGARDEN_CREDENTIAL_KEY_FILE=/run/secrets/credential_store_key
# Mailbox inventory (no passwords; those go to the encrypted credential store).
EVERGARDEN_ACCOUNT_CONFIG_FILE=/run/mail-config/mail_accounts.json

# --- Web origin, MCP and authentication --------------------------------------

# Public URL of the MCP endpoint: the audience of every bearer token and the URL
# shown in client setup. HTTPS behind a reverse proxy, or loopback HTTP for a
# single-machine install. ./deploy/setup derives it from the public origin.
EVERGARDEN_MCP_RESOURCE=http://127.0.0.1:8788/mcp
# The browser origin of the mail UI and approval pages.
EVERGARDEN_MAIL_UI_APPROVAL_URL=http://127.0.0.1:8788
# Secure cookies need HTTPS. false is accepted only while EVERGARDEN_MAIL_UI_APPROVAL_URL
# is a loopback http:// origin; set true for an https:// origin.
EVERGARDEN_ADMIN_SECURE_COOKIES=false
# Internal registry of the mail UI's own MCP token (generated by setup).
EVERGARDEN_COMPATIBILITY_TOKEN_FILE=/run/secrets/compatibility_tokens.json
# Self-service MCP API keys created in the mail UI.
EVERGARDEN_MCP_API_KEYS_FILE=/run/mcp-api-keys/api_keys.json
# Optional external OAuth authorization server for MCP clients (advanced).
# Without JWKS or introspection the issuer is only advertised, never trusted.
#EVERGARDEN_OAUTH_ISSUER=https://auth.example.invalid
#EVERGARDEN_OAUTH_JWKS_URL=https://auth.example.invalid/jwks.json
#EVERGARDEN_OAUTH_INTROSPECTION_URL=https://auth.example.invalid/introspect
#EVERGARDEN_OAUTH_INTROSPECTION_CLIENT_ID=
#EVERGARDEN_OAUTH_INTROSPECTION_CLIENT_SECRET_FILE=/run/secrets/oauth_introspection_secret

# --- Human web surfaces -------------------------------------------------------

EVERGARDEN_MAIL_UI_ENABLED=true
EVERGARDEN_APPROVAL_UI_ENABLED=true
EVERGARDEN_OAUTH_CALLBACK_ENABLED=true
# Add, edit and remove mailboxes in the mail UI.
EVERGARDEN_MAIL_UI_ACCOUNT_ADMIN_ENABLED=true
# Create and revoke MCP API keys in the mail UI.
EVERGARDEN_MAIL_UI_API_KEYS_ENABLED=true
EVERGARDEN_MAIL_UI_MCP_URL=http://mcp:8000/mcp
EVERGARDEN_MAIL_UI_MCP_TOKEN_FILE=/run/secrets/mail_ui_mcp_token
EVERGARDEN_ADMIN_CREDENTIAL_FILE=/run/secrets/admin_credentials.json
EVERGARDEN_ADMIN_SESSION_KEY_FILE=/run/secrets/admin_session_key
# Browser session lifetime (max 30 days). Logging out signs out every session
# of the administrator; the mail UI records that in the file below (writable
# for mail-ui, readable for approval-ui through ./.local/run/mail-config).
EVERGARDEN_ADMIN_SESSION_TTL_SECONDS=604800
#EVERGARDEN_ADMIN_SESSION_REVOCATION_FILE=/run/mail-config/admin_session_revocations.json
EVERGARDEN_ADMIN_LOGIN_MAX_FAILURES=15
EVERGARDEN_ADMIN_LOGIN_WINDOW_SECONDS=900
EVERGARDEN_LOG_LEVEL=INFO

# --- Provider OAuth (only for OAuth mailboxes) --------------------------------

# Password/app-password IMAP mailboxes need none of this.
# Microsoft: register your own Microsoft Entra app (public client with the
# IMAP.AccessAsUser.All, SMTP.Send and offline_access delegated permissions) and
# put its client id here; the placeholder is rejected at sign-in.
EVERGARDEN_MICROSOFT_OAUTH_CLIENT_ID=replace-with-public-client-id
EVERGARDEN_MICROSOFT_OAUTH_TENANT=common
# authorization_code redirects back to the redirect URI below; device_code shows
# a code to enter at Microsoft's device sign-in page.
EVERGARDEN_MICROSOFT_OAUTH_FLOW=authorization_code
# The app's display name as Microsoft shows it on sign-in pages (optional).
EVERGARDEN_MICROSOFT_OAUTH_APP_NAME=
EVERGARDEN_MICROSOFT_OAUTH_REDIRECT_URI=http://127.0.0.1:8788/oauth/callback/microsoft
# Google: import your own Web client JSON with
# `evergarden-provider-credential set-google-client` (see docs/providers.md).
EVERGARDEN_GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8788/oauth/callback/google

# --- Optional: Thunderbird bridge (receive-only) ------------------------------

EVERGARDEN_THUNDERBIRD_BRIDGE_ACCOUNTS=
EVERGARDEN_THUNDERBIRD_BRIDGE_CLIENTS_FILE=/run/mail-config/thunderbird-bridge-clients.json

# --- Optional: Microsoft MFA auto-login (compose profile mfa-autologin) -------

# Stores the Microsoft password and TOTP seed to re-authorize device-code
# sign-ins unattended. Needs EVERGARDEN_MICROSOFT_OAUTH_FLOW=device_code and an
# app name above. Check that your organisation's sign-in policy allows it.
EVERGARDEN_MFA_AUTOLOGIN_ENABLED=false
# Federated identity-provider hosts (e.g. your organisation's ADFS) the sign-in
# browser may visit besides Microsoft's own, comma-separated.
EVERGARDEN_MFA_EXTRA_ALLOWED_HOSTS=
EVERGARDEN_MFA_BROWSER_LOCALE=en-US
