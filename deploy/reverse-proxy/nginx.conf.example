# Plain nginx in front of Evergarden on the same host. Replace mail.example.com
# and the certificate paths, then run
#   ./deploy/setup --public-origin https://mail.example.com
# (or set the origin in .local/run/runtime.env; see README).
#
# The gateway publishes 127.0.0.1:8788 by default (EVERGARDEN_HTTP_PORT).
# Evergarden authenticates every request itself; do not add auth_request or
# basic auth here, and never forward caller-supplied identity headers.

server {
    listen 80;
    listen [::]:80;
    server_name mail.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name mail.example.com;

    ssl_certificate     /etc/ssl/example/fullchain.pem;
    ssl_certificate_key /etc/ssl/example/privkey.pem;

    client_max_body_size 24m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Remote-User "";
    proxy_set_header Remote-Groups "";
    proxy_set_header Remote-Email "";
    proxy_set_header Remote-Name "";
    proxy_set_header X-Evergarden-Proxy-Secret "";

    # Long-lived MCP streams must not be buffered.
    location ^~ /mcp {
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_pass http://127.0.0.1:8788;
    }

    location / {
        proxy_read_timeout 360s;
        proxy_send_timeout 360s;
        proxy_pass http://127.0.0.1:8788;
    }
}
