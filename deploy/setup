#!/bin/sh
# Prepare a fresh Evergarden install. See deploy/setup.py --help.
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
for python in python3 python; do
  if command -v "$python" >/dev/null 2>&1; then
    exec "$python" "$here/setup.py" "$@"
  fi
done
echo "deploy/setup needs Python 3.10 or newer (python3)" >&2
exit 1
